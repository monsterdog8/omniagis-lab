    {"name": "window", "type": "int", "description": "Window size for window_stats (default 512)"},
    {"name": "row", "type": "Dict[str, float]", "description": "Metric dict produced by analyze() for structure_score"},
    {"name": "t", "type": "np.ndarray", "description": "Time axis for step_metrics"},
    {"name": "y", "type": "np.ndarray", "description": "Signal values for step_metrics"},
    {"name": "eps", "type": "float", "description": "Settling band fraction for step_metrics (default 0.02)"},
