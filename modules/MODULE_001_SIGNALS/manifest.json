{
  "module_id": "MODULE_001_SIGNALS",
  "version": "1.0.0",
  "source_file": "gpts_core/signals.py",
  "description": "Time-series structure analysis: entropy, compression, autocorrelation, spectral, AR(2), motif metrics, composite structure score, step-response metrics, null model generation, and bootstrap confidence intervals.",
  "function": "Time-series signal analysis — entropy, autocorrelation, spectral, AR(2), motif, structure scoring",
